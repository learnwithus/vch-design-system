  "font": {
    "family": {
      "brand": {
        "value": "'proxima-nova', sans-serif",
        "note": "Adobe Fonts kit rmz3gak (site) / aze8vvi (CKEditor)"
      },
      "internal": {
        "value": "Calibri, sans-serif",
        "note": "Internal docs/email only. Never mix with Proxima Nova."
      },
      "indigenous": {
        "value": "'BC Sans', sans-serif",
        "note": "For Indigenous-language words/content"
      },
      "accessible-body": {
        "value": "'Palatino Linotype', serif",
        "note": "Long-form body copy for low-vision audiences only"
      }
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    },
    "scale": {
      "h1": {
        "desktop": "60/64 -1.8px",
        "mobile": "40/44 -1.2px",
        "weight": 600
      },
      "h2": {
        "desktop": "40/44 -1.2px",
        "mobile": "32/36 -0.96px",
        "weight": 600
      },
      "h3": {
        "desktop": "32/36 -0.96px",
        "mobile": "24/32 -0.72px",
        "weight": 600
      },
      "h4": {
        "desktop": "24/32 -0.72px",
        "mobile": "18/24 -0.36px",
        "weight": 600
      },
      "h5": {
        "desktop": "18/24 -0.36px",
        "mobile": "16/20 -0.32px",
        "weight": 600
      },
      "quote": {
        "desktop": "32/38 -0.96px",
        "mobile": "24/28 -0.48px",
        "weight": 600
      },
      "body-1": {
        "all": "24/28 -0.72px"
      },
      "body-2": {
        "all": "18/24 -0.36px",
        "note": "Default body"
      },
      "button": {
        "all": "18/24 -0.36px"
      },
      "caption": {
        "all": "16/24 -0.32px"
      },
      "media-caption": {
        "all": "14/16 -0.28px"
      },
      "label": {
        "all": "13/16 -0.26px"
      },
      "table": {
        "all": "14/16 -0.28px"
      },
      "eyebrow": {
        "all": "18/24 -0.36px",
        "weight": 400,
        "case": "uppercase",
        "note": "p.surtitle inherits Body 2; 16px margin below. No positive tracking, no smaller mobile size."
      },
      "eyebrow-card": {
        "all": "12/20 +0.6px",
        "weight": 400,
        "case": "uppercase",
        "note": "find-location .loc-type; only positive tracking in the theme"
      },
      "land-acknowledgement": {
        "gte-900": "32/40 -0.36px",
        "lt-900": "24/28 -0.36px",
        "weight": 400,
        "note": "Tracking is inherited from body, not scaled"
      },
      "copyright": {
        "all": "12/24 -0.36px",
        "weight": 400
      }
    }
  },
